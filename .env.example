# Configuration Supabase
# Copiez ce fichier vers .env.local et renseignez vos valeurs.
# Supabase > Project Settings > API
# Utilisez uniquement la clé publique publishable/anon côté navigateur.
# Ne jamais mettre la clé secrète service_role ici.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_publique_client
